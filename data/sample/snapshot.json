{"id": "sample-en-commas-rule", "createdAt": "2026-10-19T19:30:00.000Z",
  "examples": [
    {
      "note": "Comma between the day and the year",
      "ok": true,
      "s": "My birthday is June 3, 2018."
    },
    {
      "note": "Commas between the parts of the address",
      "ok": true,
      "s": "They live at 8 Lake Street, Miami, Florida."
    },
    {
      "note": "Commas in a list of three things",
      "ok": true,
      "s": "I packed pens, books, and a snack."
    },
    {
      "note": "Comma after the name",
      "ok": true,
      "s": "Sara, please open the door."
    },
    {
      "note": "Comma after no",
      "ok": true,
      "s": "No, I am not tired."
    },
    {
      "note": "Fix it: I like cats, dogs, and birds.",
      "ok": false,
      "s": "I like cats dogs and birds."
    }
  ],
  "kind": "grammar",
  "lang": "en",
  "lesson": "sample-en-2",
  "points": [
    "Between the day and the year in a date",
    "Between the parts of an address",
    "Between three or more things in a list (not after the last one)",
    "After the name of the person you talk to, and after yes or no at the start"
  ],
  "rule": "A comma is a tiny pause. It splits words apart so the reader understands the sentence.",
  "subject": "english",
  "tips": [
    "Comma = take a tiny breath!",
    "Count the things in your list: three or more need commas."
  ],
  "title": "Commas",
  "words": [
    {
      "m": "a mark that looks like this: ,",
      "w": "comma"
    },
    {
      "m": "a list of three or more things",
      "w": "series"
    },
    {
      "m": "the day, month and year",
      "w": "date"
    }
  ]
},
